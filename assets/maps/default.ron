// assets/maps/default.ron
(
    width:  50,
    height: 50,

    item_spawners: [
        ( kind: "Gold", interval_ticks: 30, max_on_map: 25, initial: 10 ),
    ],

    fixed: [
        ( x: 1,  y: 1,  tile: BaseRed  ),
        ( x: 48, y: 48, tile: BaseBlue ),
    ],

    // strategy: Fsm | BehaviorTree | Random
    // planner:  AStar | DStarLite | None
    agents: [
        ( x: 5,  y: 5,  strategy: Fsm,         planner: AStar,     team: Some(0) ),
        ( x: 45, y: 45, strategy: BehaviorTree, planner: DStarLite, team: Some(1) ),
    ],

    obstacle_clusters: [
        ( kind: Block,   count: 4,  size: (4, 4) ),
        ( kind: Block,   count: 6,  size: (2, 3) ),
        ( kind: Wall,    count: 8,  size: (5, 1) ),
        ( kind: Wall,    count: 6,  size: (3, 1) ),
        ( kind: Scatter, count: 30, size: (1, 1) ),
    ],
)