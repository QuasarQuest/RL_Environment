// assets/maps/default.ron
(
    width:  50,
    height: 50,

    match_duration_ticks: 10000,

    item_spawners: [
        // Gold: main resource — PI controller keeps 5–10 on map
        ( kind: "Gold",       max_on_map: 10, initial: 8  ),
        // Health: scarce — only 2–4 on map at once, slow respawn
        ( kind: "Health",     max_on_map: 4,  initial: 2  ),
        // Ammo: moderate — 3–6 on map, decays faster than gold
        ( kind: "Ammo",       max_on_map: 6,  initial: 3  ),
        // SpeedBoost: rare — at most 2 on map at once
        ( kind: "SpeedBoost", max_on_map: 2,  initial: 1  ),
    ],

    fixed: [
        ( x: 1,  y: 1,  tile: BaseRed  ),
        ( x: 48, y: 48, tile: BaseBlue ),
    ],

    // strategy: Fsm | BehaviorTree | Random | Goap
    // planner:  AStar | DStarLite | None
    agents: [
        ( x: 5,  y: 5,  strategy: BehaviorTreeAggressive,          planner: AStar,     team: Some(0) ),
        ( x: 45, y: 45, strategy: BehaviorTreeAggressive,  planner: AStar, team: Some(1) ),
    ],

    obstacle_clusters: [
        ( kind: Block,   count: 4,  size: (4, 4) ),
        ( kind: Block,   count: 6,  size: (2, 3) ),
        ( kind: Wall,    count: 8,  size: (5, 1) ),
        ( kind: Wall,    count: 6,  size: (3, 1) ),
        ( kind: Scatter, count: 30, size: (1, 1) ),
    ],
)
