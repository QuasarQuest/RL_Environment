// Stage 2 — adds light obstacles and the speed/slow items. 1000-tick episodes.
// The agent learns to detour for speed boosts (3 rarity tiers) and avoid the
// slow-down hazard while routing gold around scattered obstacles.
(
    width:  50,
    height: 50,
    match_duration_ticks: 1000,

    obstacles: ( density: 0.06, profile: Mixed ),

    item_density: (
        gold:   2.0,
        speed1: 0.5,   // common  — 40-tick 2× boost
        speed2: 0.25,  // uncommon — 80-tick
        speed3: 0.1,   // rare    — 160-tick
        slow:   0.4,   // hazard  — 60-tick 0.5× (avoid it)
    ),

    reward: ( tick: -0.0005, pickup: 0.5, deposit: 5.0, wall_hit: -0.01 ),
)
