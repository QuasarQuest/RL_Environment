// assets/world/config.ron
(
    width:  50,
    height: 50,

    match_duration_ticks: 10000,

    // ── Simulation speed ──────────────────────────────────────────────────────
    sim_speed:  10.0,
    sim_speeds: [1.0, 2.0, 5.0, 10.0, 25.0, 50.0, 100.0, 200.0, 500.0, 1000.0, 2500.0, 5000.0, 10000.0],

    // ── Agent ─────────────────────────────────────────────────────────────────
    respawn_ticks: 150,

    // gold_carry_speed: speed multiplier per gold unit carried.
    // Stacks multiplicatively: 0.9 per gold, carrying 3 = 0.9^3 = 0.73x speed.
    // 1.0 = no penalty. 0.0 = fully immobilised at max gold.
    gold_carry_speed: 0.95,

    // ── Base safe zone ────────────────────────────────────────────────────────
    base_safe_radius: 3,

    // ── Combat ────────────────────────────────────────────────────────────────
    melee_range:           2,
    ranged_range:          6,
    kill_reward:          15,
    melee_damage:          1,
    ranged_damage:         1,
    melee_cooldown_ticks:  4,
    ranged_cooldown_ticks: 6,

    item_spawners: [
        ( kind: "Gold",       max_on_map: 10, initial: 8 ),
        ( kind: "Health",     max_on_map: 4,  initial: 2 ),
        ( kind: "Ammo",       max_on_map: 6,  initial: 3 ),
        ( kind: "SpeedBoost", max_on_map: 2,  initial: 1 ),
    ],

    // Red base at (4,4) — Red agent spawns nearby at (4,9)
    // Blue base at (45,45) — Blue agent spawns nearby at (45,40)
    fixed: [
        ( x: 4,  y: 4,  tile: BaseRed  ),
        ( x: 45, y: 45, tile: BaseBlue ),
    ],

    agents: [
        ( x: 4,  y: 9,  strategy: BehaviorTree, planner: AStar, team: Some(0) ),
        ( x: 45, y: 40, strategy: BehaviorTree, planner: AStar, team: Some(1) ),
    ],

    obstacle_clusters: [
        ( kind: Block,   count: 4,  size: (4, 4) ),
        ( kind: Block,   count: 6,  size: (2, 3) ),
        ( kind: Wall,    count: 8,  size: (5, 1) ),
        ( kind: Wall,    count: 6,  size: (3, 1) ),
        ( kind: Scatter, count: 30, size: (1, 1) ),
    ],
)