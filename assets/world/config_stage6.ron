// assets/world/config_stage6.ron — Stage 6 (Hard / Self-play)
//
// Combat fully enabled: kill_reward and death_penalty both active.
// The sim config uses BehaviorTree as a placeholder; the Python training
// script overrides this with a frozen RL opponent (self-play).
//
// Same map as stages 4–5 — curriculum convergence, not complexity creep.

(
    width:  25,
    height: 25,
    match_duration_ticks: 3000,

    bases: [
        ( team: 0, corner: BottomLeft, margin: 0.05 ),
        ( team: 1, corner: TopRight,   margin: 0.05 ),
    ],

    agents: [
        ( team: 0, spawn: NearBase, spawn_offset: 0.10 ),
        // Placeholder — Python training replaces this with the RL opponent.
        ( team: 1, spawn: NearBase, spawn_offset: 0.10, enemy_kind: BehaviorTree ),
    ],

    safe_zone_fraction: 0.04,

    obstacles: (
        density:            0.10,
        profile:            Mixed,
        max_block_fraction: 0.12,
        max_wall_fraction:  0.14,
    ),

    item_density: (
        gold:        2.0,
        health:      0.5,
        ammo:        0.5,
        speed_boost: 0.5,
    ),

    gold_carry_speed: 0.95,

    // Full combat rewards: killing the enemy is worth 2 deposits,
    // death is penalised at the same magnitude to keep the tradeoff symmetric.
    reward: (
        tick:          -0.0005,
        pickup:         0.5,
        deposit:        5.0,
        approach:       0.05,
        kill:           2.0,
        death_penalty:  2.0,
    ),
)
