// assets/world/config_stage3.ron — Stage 3
//
// Full item set: gold + health + ammo + speed boost.
// Mixed obstacles (blocks and walls) increase navigational complexity.
// The agent must learn to weigh item utility against route cost.

(
    width:  50,
    height: 50,
    match_duration_ticks: 4000,

    bases: [
        ( team: 0, corner: BottomLeft, margin: 0.05 ),
    ],

    agents: [
        ( team: 0, spawn: NearBase, spawn_offset: 0.10 ),
    ],

    safe_zone_fraction: 0.04,

    // Scatter + small blocks — routing must detour around solid objects.
    obstacles: ( density: 0.0, profile: None, max_block_fraction: 0.12, max_wall_fraction: 0.14 ),
    obstacle_clusters: [
        ( kind: Block,   count: 3, size: (2, 2) ),
        ( kind: Block,   count: 4, size: (1, 2) ),
        ( kind: Scatter, count: 15, size: (1, 1) ),
    ],

    item_density: (
        gold:        2.0,
        health:      0.5,
        ammo:        0.5,
        speed_boost: 0.5,
    ),

    gold_carry_speed: 0.95,

    reward: (
        tick:          -0.0005,
        pickup:         0.5,
        deposit:        5.0,
        approach:       0.05,
        kill:           0.0,
        death_penalty:  0.0,
    ),
)
