// Stage 3 — full item mix + denser obstacles + slightly scarcer gold (−10%).
// 1500-tick episodes. Adds the score multiplier (2× deposits while active) on top
// of the speed/slow items from stage 2.
(
    width:  50,
    height: 50,
    match_duration_ticks: 1500,

    obstacles: ( density: 0.12, profile: Mixed ),

    item_density: (
        gold:       1.8,   // 10% scarcer than stages 1–2
        speed1:     0.5,
        speed2:     0.25,
        speed3:     0.1,
        slow:       0.4,
        multiplier: 0.2,   // uncommon — 100-tick 2× deposits
    ),

    reward: ( tick: -0.0005, pickup: 0.5, deposit: 5.0, wall_hit: -0.01 ),
)
