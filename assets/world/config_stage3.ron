// Stage 3 — full item mix + denser obstacles. 3000-tick episodes (doubled from 1500
// for the half-rate movement cadence). Mirrors the
// viewer showcase (default.ron): on top of stage 2's speed boost it adds the score
// multiplier (a charge that doubles the next deposit).
(
    width:  50,
    height: 50,
    match_duration_ticks: 3000,

    obstacles: ( density: 0.15, profile: Mixed ),

    // One speed item; density trimmed ~20% (0.4 → 0.32).
    item_density: (
        gold:       0.5,
        speed:      0.12,
        multiplier: 0.05,
        // Gold in 2–3-tile clumps + sparse singletons (count unchanged; 0 = uniform).
        gold_clustering: ( clustered_fraction: 0.7, clump_size: (2, 3), radius: 1 ),
    ),

    // option_gamma is the per-tick discount; it MUST equal ppo.gamma (configs/ppo)
    // — one rate at two hierarchy levels, asserted at startup (training/train.py).
    reward: ( tick: -0.0005, pickup: 0.5, deposit: 5.0, wall_hit: -0.01, option_gamma: 0.99 ),
)
