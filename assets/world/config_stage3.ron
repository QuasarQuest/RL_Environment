// Stage 3 — full item mix + denser obstacles. 1500-tick episodes. Mirrors the
// viewer showcase (default.ron): on top of stage 2's speed/slow it adds the score
// multiplier (2× deposits while active) AND the Trap hazard (immobilises 250 ticks).
(
    width:  50,
    height: 50,
    match_duration_ticks: 1500,

    obstacles: ( density: 0.15, profile: Mixed ),

    item_density: (
        gold:       1.0,
        speed1:     0.4,
        speed2:     0.2,
        speed3:     0.1,
        slow:       0.35,
        multiplier: 0.2,
        trap:       0.2,
    ),

    reward: ( tick: -0.0005, pickup: 0.5, deposit: 5.0, wall_hit: -0.01, mult_use_bonus: 0.5 ),
)
