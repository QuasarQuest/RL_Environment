// assets/world/config_stage4.ron — Stage 4
//
// Introduces a SimpleChaser enemy (greedy, no pathfinding).
// Larger 25×25 map gives more room for evasion without making the task trivial.
// Agent must learn to avoid the enemy while collecting gold.

(
    width:  25,
    height: 25,
    match_duration_ticks: 2500,

    bases: [
        ( team: 0, corner: BottomLeft, margin: 0.05 ),
        ( team: 1, corner: TopRight,   margin: 0.05 ),
    ],

    agents: [
        // RL agent — EnemyKind::None means the sim ignores it (Python controls it).
        ( team: 0, spawn: NearBase, spawn_offset: 0.10 ),
        // Easy scripted enemy: greedy direction toward gold / own base.
        ( team: 1, spawn: NearBase, spawn_offset: 0.10, enemy_kind: SimpleChaser ),
    ],

    safe_zone_fraction: 0.04,

    obstacles: (
        density:            0.10,
        profile:            Mixed,
        max_block_fraction: 0.12,
        max_wall_fraction:  0.14,
    ),

    item_density: (
        gold:        2.0,
        health:      0.5,
        ammo:        0.5,
        speed_boost: 0.5,
    ),

    gold_carry_speed: 0.95,

    // No kill reward yet — agent should focus on evasion and gold, not combat.
    reward: (
        tick:          -0.0005,
        pickup:         0.5,
        deposit:        5.0,
        approach:       0.05,
        kill:           0.0,
        death_penalty:  0.5,
    ),
)
