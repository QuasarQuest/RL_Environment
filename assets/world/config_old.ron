// assets/world/config.ron

(
    width:  100,
    height: 100,

    match_duration_ticks: 2500,

    // ── Game mode ─────────────────────────────────────────────────────────────
    game_mode: GoldRush,

    // ── Simulation speed ──────────────────────────────────────────────────────
    sim_speed:  10.0,
    sim_speeds: [
        1.0, 2.0, 5.0, 10.0, 25.0, 50.0, 100.0, 200.0,
        500.0, 1000.0, 2500.0, 5000.0, 10000.0
    ],

    // ── Bases ─────────────────────────────────────────────────────────────────
    // margin: fraction of shorter grid dimension → 0.08 × 50 = 4 tiles inset.
    bases: [
        ( team: 0, corner: BottomLeft, margin: 0.05 ),
        // ( team: 1, corner: TopRight,   margin: 0.05 ),
    ],

    // ── Agents ────────────────────────────────────────────────────────────────
    // spawn_offset: fraction of shorter grid dimension → 0.10 × 50 = 5 tiles from base.
    agents: [
        ( team: 0, strategy: BehaviorTree, planner: AStar, spawn: NearBase, spawn_offset: 0.10 ),
        // ( team: 1, strategy: BehaviorTree, planner: AStar, spawn: NearBase, spawn_offset: 0.10 ),
    ],

    // ── Safe zone ─────────────────────────────────────────────────────────────
    // Fraction of grid diagonal. Default DEFAULT_SAFE_ZONE_FRACTION = 0.06.
    // 0.06 × 70.7 (50×50 diagonal) ≈ 4 tiles. Scales automatically with map size.
    safe_zone_fraction: 0.03,

    // ── Obstacles ─────────────────────────────────────────────────────────────
    // density: fraction of total tiles → 0.08 = 8% become obstacles.
    obstacles: (
        density:            0.08,
        profile:            Mixed,
        max_block_fraction: 0.12,
        max_wall_fraction:  0.14,
    ),

    // ── Items ─────────────────────────────────────────────────────────────────
    // Unit: items per 100 free tiles after obstacle placement.
    // At 50×50 with 8% obstacles ≈ 2100 free tiles:
    //   gold 0.5 → ~10 items   health 0.3 → ~6   ammo 0.4 → ~8   speed 0.1 → ~2
    item_density: (
        gold:        0.05,
        health:      0.025,
        ammo:        0.010,
        speed_boost: 0.009,
    ),

    // ── Agent stats ───────────────────────────────────────────────────────────
    respawn_ticks:    150,
    gold_carry_speed: 0.95,

    // ── Combat ────────────────────────────────────────────────────────────────
    melee_range:           2,
    ranged_range:          6,
    kill_reward:           15,
    melee_damage:          1,
    ranged_damage:         1,
    melee_cooldown_ticks:  4,
    ranged_cooldown_ticks: 6,
)