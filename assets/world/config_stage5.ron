// assets/world/config_stage5.ron — Stage 5
//
// Hard enemy: BehaviorTree (A* pathfinding).
// The enemy finds optimal routes — the agent can no longer rely on the
// enemy getting stuck against walls. Requires active evasion.

(
    width:  50,
    height: 50,
    match_duration_ticks: 5000,

    bases: [
        ( team: 0, corner: BottomLeft, margin: 0.05 ),
        ( team: 1, corner: TopRight,   margin: 0.05 ),
    ],

    agents: [
        ( team: 0, spawn: NearBase, spawn_offset: 0.10 ),
        // Hard enemy: A* pathfinding, always finds shortest path.
        ( team: 1, spawn: NearBase, spawn_offset: 0.10, enemy_kind: BehaviorTree ),
    ],

    safe_zone_fraction: 0.04,

    // Same as stage 4 but longer walls — harder to read the enemy's path.
    obstacles: ( density: 0.0, profile: None, max_block_fraction: 0.12, max_wall_fraction: 0.14 ),
    obstacle_clusters: [
        ( kind: Block,   count: 2, size: (2, 2) ),
        ( kind: Block,   count: 3, size: (1, 2) ),
        ( kind: Wall,    count: 5, size: (3, 1) ),
        ( kind: Wall,    count: 3, size: (2, 1) ),
        ( kind: Scatter, count: 20, size: (1, 1) ),
    ],

    item_density: (
        gold:        2.0,
        health:      0.5,
        ammo:        0.5,
        speed_boost: 0.5,
    ),

    gold_carry_speed: 0.95,

    reward: (
        tick:          -0.0005,
        pickup:         0.5,
        deposit:        5.0,
        approach:       0.05,
        kill:           0.0,
        death_penalty: -0.5,
    ),
)
